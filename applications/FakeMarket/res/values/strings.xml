<!-- This file contains resource definitions for displayed strings, allowing
     them to be changed based on the locale and options. -->

<resources>
    <string name="app_name">Fake Market</string>
    <string name="app_name_launcher">Market</string>

    <string name="main_text">This is an app that spoofs the Market icon seen in the top right corner of the all apps list in Android Honeycomb and onwards. The application acts as an app market in order to trick the operating system into thinking one is installed. It does not serve any other purpose.</string>
    <string name="sub_text">If the application does not run after pressing the icon in the all apps list, the device must be rebooted before the feature will start working.</string>
    <string name="author_text">By Froyocomb @ 2026</string>
</resources>
